# Spring Boot Backend API Base URL
VITE_API_BASE_URL="http://localhost:8080"

# Public Google OAuth Web client ID (never put a client secret in VITE_*).
# Copy one Web client ID from the backend's GOOGLE_CLIENT_IDS into .env.local.
# Restart Vite after changing env; rebuild the frontend for production.
# Add the frontend origin (e.g. http://localhost:5173) to the client's
# Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
